{
    "$schema": "https://git.flecs.tech/flecs/app-manifest/raw/branch/3.3.0/manifest.schema.json",
    "_schemaVersion": "3.3.0",
    "app": "com.herborner-pumpen.hp.aicore",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.herborner-pumpen.hp.aicore",
    "multiInstance": false,
    "editors": [{  "name": "AiCore WebUI",  "port": 9330,  "supportsReverseProxy": true}],
    "env":[
        "LOGLEVEL=notice"
    ],
    "volumes":[
        "data:/app/data"
    ],
    "credential": {
        "type": "certificate"
    },
    "permissions": {
        "api": {
            "tech.flecs.core": {
                "read_apps": {},
                "read_instances": {},
                "read_system_info": {},
                "read_license_info": {},
                "jobs": {},
                "start_instance": {},
                "stop_instance": {},
                "install_app": {},
                "update_instance": {},
                "create_instance": {},
                "instance_config_set_environment_variable": {}
            }
        }
    }
}
