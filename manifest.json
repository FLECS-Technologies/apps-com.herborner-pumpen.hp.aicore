{
    "$schema": "https://git.flecs.tech/flecs/app-manifest/raw/branch/3.3.0/manifest.schema.json",
    "_schemaVersion": "3.3.0",
    "app": "com.herborner-pumpen.hp.aicore",
    "version": "##VERSION##",
    "revision": "0",
    "image": "flecs.azurecr.io/com.herborner-pumpen.hp.aicore",
    "multiInstance": false,
    "editors": [{  "name": "AiCore WebUI",  "port": 9330,  "supportsReverseProxy": true}],
    "env":[
        "LOGLEVEL=notice"
    ],
    "volumes":[
        "data:/app/data"
    ],
    "permissions": {
        "api": {
            "authMethod": "certificate",
            "roles": [
                { "roleId": "tech.flecs.core.get_apps" },
                { "roleId": "tech.flecs.core.read_instances" },
                { "roleId": "tech.flecs.core.read_instance" },
                { "roleId": "tech.flecs.core.read_system_info" },
                { "roleId": "tech.flecs.core.read_version" },
                { "roleId": "tech.flecs.core.read_license_info" },
                { "roleId": "tech.flecs.core.start_instance" },
                { "roleId": "tech.flecs.core.stop_instance" },
                { "roleId": "tech.flecs.core.read_quest" },
                { "roleId": "tech.flecs.core.install_app" },
                { "roleId": "tech.flecs.core.update_instance" },
                { "roleId": "tech.flecs.core.create_instance" },
                { "roleId": "tech.flecs.core.instance_config_set_environment_variable" },
                { "roleId": "tech.flecs.core.remove_quest" }
            ]
        }
    }
}
